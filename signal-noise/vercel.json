{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index?__path=/mcp" },
    { "source": "/api/:op", "destination": "/api/index?__path=/api/:op" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
