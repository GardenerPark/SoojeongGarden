# 복사해서 .env 로 저장하세요. .env 는 git에 올라가지 않아요.
# AI_PROVIDER: openclaw | hermes | claude-cli | none
AI_PROVIDER=none

# OpenClaw  → 기본 http://127.0.0.1:18789/v1, model=openclaw/default
# Hermes    → 기본 http://127.0.0.1:8642/v1,  model=hermes-agent
# AI_BASE_URL=
# AI_MODEL=

# OpenClaw: gateway.auth.token (OPENCLAW_GATEWAY_TOKEN)
# Hermes:   ~/.hermes/.env 의 API_SERVER_KEY
AI_TOKEN=

# PORT=8000
# AI_TIMEOUT_MS=60000
